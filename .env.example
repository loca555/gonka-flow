# Only public RPC endpoints. Never enter a seed phrase or private key.
APP_MODE=mints
INDEXER_ENABLED=true
# Only enable on a clean/disposable deployment. Existing DBs are never replaced.
LOAD_SEED_ARCHIVE=false
# In mints mode Ethereum WGNK mint, transfer and verified pool events are collected from contract creation.
# GNK, holder-census and June-7 settings below apply only to the legacy full mode.
LOOKBACK_HOURS=24
POLL_SECONDS=6
NATIVE_BATCH=6
# Optional absolute historical lower bounds (0 = relative lookback at first launch).
GONKA_START_HEIGHT=0
ETH_START_HEIGHT=0
# Exact date window (with timezone). Requires both matching start heights above.
# Resolve them with: python -m app.history --from 2026-06-07T00:00:00+03:00
HISTORY_FROM=
# Public community RPC for blocks; official nodes remain fallbacks.
GONKA_RPC_URLS=https://rpc.gonka.gg
# Verified full raw-block/result JSON-RPC roots; CometBFT allows 10 methods = 5 blocks per HTTP batch.
GONKA_ARCHIVE_RPC_URLS=https://node1.gonka.ai:8443/chain-rpc,https://node2.gonka.ai:8443/chain-rpc,https://node3.gonka.ai/chain-rpc
NATIVE_HISTORY_BATCH=5
# Live and archive have separate queues. Only add verified archive-capable endpoints below.
ETH_RPC_URLS=https://ethereum-rpc.publicnode.com,https://rpc.mevblocker.io
ETH_ARCHIVE_RPC_URLS=https://rpc.mevblocker.io
# Minimum seconds between requests to the SAME endpoint (shared across both queues).
ETH_RPC_INTERVAL=1
ETH_HISTORY_BATCH=1000
GONKA_URLS=https://node1.gonka.ai:8443,https://node3.gonka.ai,https://node2.gonka.ai:8443
